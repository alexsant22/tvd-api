    "/api/characters/{id}": {
      "get": {
        "tags": [
          "Personagens"
        ],
        "summary": "Detalhe de um personagem",
        "operationId": "detalhar_characters",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador numérico.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "O item pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Character"
                },
                "example": {
                  "id": 1,
                  "name": "Elena Gilbert",
                  "actor": "Nina Dobrev",
                  "species": [
                    "https://tvd-api.vercel.app/api/species/1",
                    "https://tvd-api.vercel.app/api/species/8",
                    "https://tvd-api.vercel.app/api/species/2"
                  ],
                  "family": "https://tvd-api.vercel.app/api/families/2",
                  "description": "Protagonista da série. Doppelgänger de Katherine, se apaixona por Stefan e depois por Damon.",
                  "image": "https://static.tvmaze.com/uploads/images/medium_portrait/0/1494.jpg",
                  "episodeCount": 134,
                  "url": "https://tvd-api.vercel.app/api/characters/1"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          }
        }
      }
    },
