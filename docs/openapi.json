{
  "openapi": "3.1.0",
  "info": {
    "title": "tvd-api",
    "version": "1.0.0",
    "description": "API REST de **The Vampire Diaries**, aberta e somente leitura, sem autenticação e com CORS liberado.\n\nAs respostas seguem o formato da [SWAPI](https://swapi.dev): listas paginadas com `count`, `next`, `previous` e `results`, e relações entre recursos como URLs. Para pegar a família de um personagem, por exemplo, basta fazer um GET na URL do campo `family`.\n\nDescrições, espécies e resumos dos episódios estão em português. Títulos dos episódios e créditos ficam no original.\n\nFontes: [afaf98/Vampire_diaries_API](https://github.com/afaf98/Vampire_diaries_API) e [TVMaze](https://www.tvmaze.com/api) (CC BY-SA), mais dados escritos à mão. A foto da Tatia Petrova vem da [The Vampire Diaries Wiki](https://vampirediaries.fandom.com/wiki/Tatia).",
    "license": {
      "name": "Dados: CC BY-SA 4.0, por virem em parte da TVMaze. Código: MIT",
      "url": "https://creativecommons.org/licenses/by-sa/4.0/"
    }
  },
  "externalDocs": {
    "description": "Código no GitHub",
    "url": "https://github.com/alexsant22/tvd-api"
  },
  "servers": [
    {
      "url": "https://tvd-api.vercel.app",
      "description": "Produção (Vercel)"
    }
  ],
  "tags": [
    {
      "name": "Raiz",
      "description": "Ponto de partida."
    },
    {
      "name": "Personagens",
      "description": "49 personagens."
    },
    {
      "name": "Episódios",
      "description": "171 episódios."
    },
    {
      "name": "Temporadas",
      "description": "8 temporadas."
    },
    {
      "name": "Espécies",
      "description": "9 espécies."
    },
    {
      "name": "Famílias",
      "description": "10 famílias."
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "tags": [
          "Raiz"
        ],
        "summary": "Lista os recursos",
        "description": "Ponto de partida da API: devolve a URL de cada recurso.",
        "operationId": "raiz",
        "responses": {
          "200": {
            "description": "URL de cada recurso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "characters": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL da lista de personagens."
                    },
                    "episodes": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL da lista de episódios."
                    },
                    "seasons": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL da lista de temporadas."
                    },
                    "species": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL da lista de espécies."
                    },
                    "families": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL da lista de famílias."
                    }
                  },
                  "required": [
                    "characters",
                    "episodes",
                    "seasons",
                    "species",
                    "families"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "characters": "https://tvd-api.vercel.app/api/characters",
                  "episodes": "https://tvd-api.vercel.app/api/episodes",
                  "seasons": "https://tvd-api.vercel.app/api/seasons",
                  "species": "https://tvd-api.vercel.app/api/species",
                  "families": "https://tvd-api.vercel.app/api/families"
                }
              }
            }
          }
        }
      }
    },
    "/api/characters": {
      "get": {
        "tags": [
          "Personagens"
        ],
        "summary": "Lista personagens",
        "description": "Lista paginada de personagens: 49 no total, 10 por página. Para trazer a lista inteira, siga `next` até ele vir null.",
        "operationId": "listar_characters",
        "parameters": [
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Filtra pelo nome. Busca por trecho, sem diferenciar maiúsculas nem acentos. O filtro continua nos links `next` e `previous`.",
            "schema": {
              "type": "string"
            },
            "example": "salvatore"
          }
        ],
        "responses": {
          "200": {
            "description": "Página da lista. Busca sem resultado também responde 200, com `count` 0 e `results` vazio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaCharacter"
                },
                "examples": {
                  "busca_salvatore": {
                    "summary": "GET /api/characters?name=salvatore",
                    "value": {
                      "count": 5,
                      "next": null,
                      "previous": null,
                      "results": [
                        {
                          "id": 2,
                          "name": "Stefan Salvatore",
                          "actor": "Paul Wesley",
                          "species": [
                            "https://tvd-api.vercel.app/api/species/1",
                            "https://tvd-api.vercel.app/api/species/2",
                            "https://tvd-api.vercel.app/api/species/8"
                          ],
                          "family": "https://tvd-api.vercel.app/api/families/1",
                          "description": "Vampiro de 1864 que tenta viver entre humanos sem beber sangue humano. Doppelgänger de Silas.",
                          "image": "https://static.tvmaze.com/uploads/images/medium_portrait/570/1425603.jpg",
                          "episodeCount": 171,
                          "url": "https://tvd-api.vercel.app/api/characters/2"
                        },
                        {
                          "id": 3,
                          "name": "Damon Salvatore",
                          "actor": "Ian Somerhalder",
                          "species": [
                            "https://tvd-api.vercel.app/api/species/1",
                            "https://tvd-api.vercel.app/api/species/2"
                          ],
                          "family": "https://tvd-api.vercel.app/api/families/1",
                          "description": "Irmão mais velho de Stefan. Começa a série como antagonista e vai se tornando aliado do grupo.",
                          "image": "https://static.tvmaze.com/uploads/images/medium_portrait/0/465.jpg",
                          "episodeCount": 171,
                          "url": "https://tvd-api.vercel.app/api/characters/3"
                        },
                        {
                          "id": 33,
                          "name": "Giuseppe Salvatore",
                          "actor": "James Remar",
                          "species": [
                            "https://tvd-api.vercel.app/api/species/1"
                          ],
                          "family": "https://tvd-api.vercel.app/api/families/1",
                          "description": "Pai de Stefan e Damon, caçador de vampiros em 1864.",
                          "image": "https://static.tvmaze.com/uploads/images/medium_portrait/157/393379.jpg",
                          "episodeCount": null,
                          "url": "https://tvd-api.vercel.app/api/characters/33"
                        },
                        {
                          "id": 34,
                          "name": "Lily Salvatore",
                          "actor": "Annie Wersching",
                          "species": [
                            "https://tvd-api.vercel.app/api/species/1",
                            "https://tvd-api.vercel.app/api/species/2"
                          ],
                          "family": "https://tvd-api.vercel.app/api/families/1",
                          "description": "Mãe de Stefan e Damon, que eles julgavam morta desde a infância.",
                          "image": "https://static.tvmaze.com/uploads/images/medium_portrait/81/204142.jpg",
                          "episodeCount": null,
                          "url": "https://tvd-api.vercel.app/api/characters/34"
                        },
                        {
                          "id": 35,
                          "name": "Zach Salvatore",
                          "actor": "Chris William Martin",
                          "species": [
                            "https://tvd-api.vercel.app/api/species/1"
                          ],
                          "family": "https://tvd-api.vercel.app/api/families/1",
                          "description": "Descendente humano dos Salvatore, que guarda a pensão da família.",
                          "image": "https://static.tvmaze.com/uploads/images/medium_portrait/507/1267795.jpg",
                          "episodeCount": null,
                          "url": "https://tvd-api.vercel.app/api/characters/35"
                        }
                      ]
                    }
